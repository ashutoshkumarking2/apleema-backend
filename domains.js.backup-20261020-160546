const router = require("express").Router();
const { requireAuth } = require("./auth");
const { vfetch } = require("./vercel");

router.use(requireAuth);

const fail = (res, e) =>
  res.status(e.status || 500).json({ error: e.message });

const DOMAIN_RE =
  /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/i;

function domainError(data, fallback) {
  return data?.error?.message || data?.message || fallback;
}

// Search domain availability and registration price.
router.get("/search", async (req, res) => {
  const name = String(req.query.name || "").trim().toLowerCase();

  if (!DOMAIN_RE.test(name)) {
    return res.status(400).json({
      name,
      available: null,
      price: null,
      status: "unknown",
      error: "Enter a valid domain like example.com",
    });
  }

  try {
    const response = await fetch(
      "https://api.vercel.com/v1/registrar/domains/search",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ domains: [name] }),
        signal: AbortSignal.timeout(10000),
      }
    );

    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      console.error("Vercel domain search failed:", response.status, data);
      return res.json({
        name,
        available: null,
        price: null,
        status: "unknown",
        error: "Registrar availability could not be verified.",
      });
    }

    const candidates = [
      ...(Array.isArray(data) ? data : []),
      ...(Array.isArray(data.domains) ? data.domains : []),
      ...(Array.isArray(data.results) ? data.results : []),
      ...(Array.isArray(data.results?.domains) ? data.results.domains : []),
    ];

    const item =
      candidates.find(
        (x) =>
          String(x?.domain || x?.name || "").trim().toLowerCase() === name
      ) ||
      (data[name] && typeof data[name] === "object" ? data[name] : null) ||
      (data.result && typeof data.result === "object" ? data.result : null) ||
      (candidates.length === 1 ? candidates[0] : null);

    const normalizeBoolean = (value) => {
      if (value === true || value === "true") return true;
      if (value === false || value === "false") return false;
      return null;
    };

    let available = null;

    if (item && typeof item === "object") {
      for (const key of [
        "available",
        "isAvailable",
        "canRegister",
        "registrationAvailable",
      ]) {
        const parsed = normalizeBoolean(item[key]);
        if (parsed !== null) {
          available = parsed;
          break;
        }
      }

      if (available === null) {
        const status = String(item.status || "").trim().toLowerCase();

        if (["available", "available_to_register"].includes(status)) {
          available = true;
        } else if (
          ["registered", "taken", "unavailable", "not_available"].includes(status)
        ) {
          available = false;
        }
      }
    }

    const price = item
      ? item.price ??
        item.registrationPrice ??
        item.registration_price ??
        item.pricing?.registration ??
        null
      : null;

    return res.json({
      name,
      available,
      price,
      status:
        available === true
          ? "available"
          : available === false
            ? "registered"
            : "unknown",
      source: "vercel-registrar",
    });
  } catch (e) {
    console.error("Domain availability lookup error:", e.message);

    return res.json({
      name,
      available: null,
      price: null,
      status: "unknown",
      error: "Registrar availability could not be verified. Please try again.",
    });
  }
});
// List domains attached to projects in the connected Vercel scope.
router.get("/", async (req, res) => {
  try {
    const result = await vfetch(req.uid, "/v9/projects?limit=50");
    const projects = result.projects || [];

    const lists = await Promise.all(
      projects.map(async (project) => {
        const result = await vfetch(
          req.uid,
          `/v9/projects/${encodeURIComponent(project.id || project.name)}/domains`
        );

        return (result.domains || []).map((domain) => ({
          name: domain.name,
          verified: Boolean(domain.verified),
          projectId: project.id,
          projectName: project.name,
        }));
      })
    );

    res.json(lists.flat());
  } catch (e) {
    fail(res, e);
  }
});

// Add a domain to a Vercel project.
router.post("/add", async (req, res) => {
  try {
    const projectId = String(req.body.projectId || "").trim();
    const name = String(req.body.domain || "").trim().toLowerCase();

    if (!projectId || !DOMAIN_RE.test(name)) {
      return res.status(400).json({
        error: "Valid project and domain required",
      });
    }

    const result = await vfetch(
      req.uid,
      `/v10/projects/${encodeURIComponent(projectId)}/domains`,
      {
        method: "POST",
        body: JSON.stringify({ name }),
      }
    );

    res.json({
      name: result.name || name,
      verified: Boolean(result.verified),
      verification: result.verification || [],
    });
  } catch (e) {
    fail(res, e);
  }
});

// Verify the domain and return Vercel's recommended DNS values.
router.post("/verify", async (req, res) => {
  try {
    const projectId = String(req.body.projectId || "").trim();
    const name = String(req.body.domain || "").trim().toLowerCase();

    if (!projectId || !DOMAIN_RE.test(name)) {
      return res.status(400).json({
        error: "Valid project and domain required",
      });
    }

    const encodedProject = encodeURIComponent(projectId);
    const encodedDomain = encodeURIComponent(name);

    const verification = await vfetch(
      req.uid,
      `/v9/projects/${encodedProject}/domains/${encodedDomain}/verify`,
      { method: "POST" }
    );

    const config = await vfetch(
      req.uid,
      `/v6/domains/${encodedDomain}/config?projectIdOrName=${encodedProject}`
    );

    const labels = name.split(".");
    const twoLabelSuffixes = new Set([
      "co.uk", "org.uk", "ac.uk",
      "com.au", "net.au", "org.au",
      "co.in", "firm.in", "net.in", "org.in",
      "co.nz", "com.br", "com.cn",
      "co.jp", "co.kr", "com.sg",
    ]);

    const suffix = labels.slice(-2).join(".");
    const suffixLength = twoLabelSuffixes.has(suffix) ? 2 : 1;
    const isApex = labels.length === suffixLength + 1;

    const ipv4 = (config.recommendedIPv4 || []).find(
      (record) => Number(record.rank) === 1
    )?.value;

    const cname = (config.recommendedCNAME || []).find(
      (record) => Number(record.rank) === 1
    )?.value;

    const records = [];

    if (isApex && ipv4) {
      for (const value of Array.isArray(ipv4) ? ipv4 : [ipv4]) {
        records.push({ type: "A", name: "@", value });
      }
    } else if (!isApex && cname) {
      records.push({
        type: "CNAME",
        name: labels.slice(0, -(suffixLength + 1)).join("."),
        value: cname,
      });
    }

    res.json({
      verified: Boolean(verification.verified),
      misconfigured: Boolean(config.misconfigured),
      records,
      verification: verification.verification || [],
    });
  } catch (e) {
    fail(res, e);
  }
});


/* Live RDAP registration date + real DNS resolver checks */
router.get("/info", async (req, res) => {
  const name = String(req.query.domain || "").trim().toLowerCase();

  if (!DOMAIN_RE.test(name)) {
    return res.status(400).json({ error: "Enter a valid domain name." });
  }

  const checkDns = async (base, type, resolver) => {
    try {
      const url = new URL(base);
      url.searchParams.set("name", name);
      url.searchParams.set("type", type);

      const response = await fetch(url, {
        headers: { Accept: "application/dns-json, application/json" },
        signal: AbortSignal.timeout(8000),
      });
      const data = await response.json();

      return {
        resolver,
        type,
        ok: response.ok,
        status: data.Status ?? null,
        answers: (data.Answer || []).map((a) => ({
          type: a.type,
          ttl: a.TTL,
          data: a.data,
        })),
        error: response.ok ? null : `HTTP ${response.status}`,
      };
    } catch (e) {
      return {
        resolver,
        type,
        ok: false,
        status: null,
        answers: [],
        error: e.message,
      };
    }
  };

  const dnsQueries = [];
  for (const type of ["A", "AAAA", "CNAME", "NS"]) {
    dnsQueries.push(
      checkDns("https://dns.google/resolve", type, "Google Public DNS"),
      checkDns("https://cloudflare-dns.com/dns-query", type, "Cloudflare DNS")
    );
  }

  const rdapPromise = (async () => {
    try {
      const response = await fetch(
        `https://rdap.org/domain/${encodeURIComponent(name)}`,
        {
          headers: { Accept: "application/rdap+json, application/json" },
          signal: AbortSignal.timeout(10000),
        }
      );

      if (response.status === 404) {
        return { lookup: "not_found", registered: false };
      }

      if (!response.ok) {
        return {
          lookup: "error",
          registered: null,
          error: `RDAP HTTP ${response.status}`,
        };
      }

      const data = await response.json();
      const events = data.events || [];
      const eventDate = (...actions) => {
        const event = events.find((e) =>
          actions.includes(String(e.eventAction || "").toLowerCase())
        );
        return event?.eventDate || null;
      };

      const createdAt = eventDate("registration", "registered", "creation");
      const expiresAt = eventDate("expiration", "expiry");
      const registrar = (data.entities || []).find((entity) =>
        (entity.roles || []).includes("registrar")
      );

      const vcard = registrar?.vcardArray?.[1] || [];
      const registrarName =
        vcard.find((item) => item[0] === "fn")?.[3] || null;

      return {
        lookup: "ok",
        registered: true,
        createdAt,
        registrationYear: createdAt
          ? new Date(createdAt).getUTCFullYear()
          : null,
        expiresAt,
        registrar: registrarName,
        statuses: data.status || [],
      };
    } catch (e) {
      return {
        lookup: "error",
        registered: null,
        error: e.message,
      };
    }
  })();

  const [rdap, dns] = await Promise.all([
    rdapPromise,
    Promise.all(dnsQueries),
  ]);

  const successfulResolvers = [...new Set(
    dns.filter((x) => x.ok && x.answers.length > 0).map((x) => x.resolver)
  )];

  res.json({
    domain: name,
    registration: rdap,
    dns: {
      checks: dns,
      respondingResolvers: successfulResolvers,
      hasDnsAnswers: dns.some((x) => x.ok && x.answers.length > 0),
      note: "DNS answers alone do not prove that Vercel configuration is correct.",
    },
  });
});

module.exports = router;
