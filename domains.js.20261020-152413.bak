const router = require("express").Router();
const { requireAuth } = require("./auth");
const { vfetch } = require("./vercel");

router.use(requireAuth);

const fail = (res, e) =>
  res.status(e.status || 500).json({ error: e.message });

const DOMAIN_RE =
  /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/i;

function domainError(data, fallback) {
  return data?.error?.message || data?.message || fallback;
}

// Search domain availability and registration price via the current Registrar API.
router.get("/search", async (req, res) => {
  try {
    const name = String(req.query.name || "").trim().toLowerCase();

    if (!DOMAIN_RE.test(name)) {
      return res.status(400).json({
        error: "Enter a valid domain like example.com",
      });
    }

    const response = await fetch(
      "https://api.vercel.com/v1/registrar/domains/search",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ domains: [name] }),
      }
    );

    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      const error = new Error(
        domainError(data, "Vercel domain search failed")
      );
      error.status = response.status;
      throw error;
    }

    const candidates = [
      ...(Array.isArray(data) ? data : []),
      ...(Array.isArray(data.domains) ? data.domains : []),
      ...(Array.isArray(data.results) ? data.results : []),
      ...(Array.isArray(data.results?.domains) ? data.results.domains : []),
    ];

    const item =
      candidates.find(
        (x) =>
          String(x.domain || x.name || "").toLowerCase() === name
      ) ||
      data[name] ||
      data.result ||
      (candidates.length ? candidates[0] : data);

    const available =
      item.available ??
      item.isAvailable ??
      item.canRegister ??
      item.registrationAvailable ??
      (String(item.status || "").toLowerCase() === "available");

    const price =
      item.price ??
      item.registrationPrice ??
      item.registration_price ??
      item.pricing?.registration ??
      null;

    res.json({
      name,
      available: Boolean(available),
      price,
    });
  } catch (e) {
    fail(res, e);
  }
});

// List domains attached to projects in the connected Vercel scope.
router.get("/", async (req, res) => {
  try {
    const result = await vfetch(req.uid, "/v9/projects?limit=50");
    const projects = result.projects || [];

    const lists = await Promise.all(
      projects.map(async (project) => {
        const result = await vfetch(
          req.uid,
          `/v9/projects/${encodeURIComponent(project.id || project.name)}/domains`
        );

        return (result.domains || []).map((domain) => ({
          name: domain.name,
          verified: Boolean(domain.verified),
          projectId: project.id,
          projectName: project.name,
        }));
      })
    );

    res.json(lists.flat());
  } catch (e) {
    fail(res, e);
  }
});

// Add a domain to a Vercel project.
router.post("/add", async (req, res) => {
  try {
    const projectId = String(req.body.projectId || "").trim();
    const name = String(req.body.domain || "").trim().toLowerCase();

    if (!projectId || !DOMAIN_RE.test(name)) {
      return res.status(400).json({
        error: "Valid project and domain required",
      });
    }

    const result = await vfetch(
      req.uid,
      `/v10/projects/${encodeURIComponent(projectId)}/domains`,
      {
        method: "POST",
        body: JSON.stringify({ name }),
      }
    );

    res.json({
      name: result.name || name,
      verified: Boolean(result.verified),
      verification: result.verification || [],
    });
  } catch (e) {
    fail(res, e);
  }
});

// Verify the domain and return Vercel's recommended DNS values.
router.post("/verify", async (req, res) => {
  try {
    const projectId = String(req.body.projectId || "").trim();
    const name = String(req.body.domain || "").trim().toLowerCase();

    if (!projectId || !DOMAIN_RE.test(name)) {
      return res.status(400).json({
        error: "Valid project and domain required",
      });
    }

    const encodedProject = encodeURIComponent(projectId);
    const encodedDomain = encodeURIComponent(name);

    const verification = await vfetch(
      req.uid,
      `/v9/projects/${encodedProject}/domains/${encodedDomain}/verify`,
      { method: "POST" }
    );

    const config = await vfetch(
      req.uid,
      `/v6/domains/${encodedDomain}/config?projectIdOrName=${encodedProject}`
    );

    const labels = name.split(".");
    const twoLabelSuffixes = new Set([
      "co.uk", "org.uk", "ac.uk",
      "com.au", "net.au", "org.au",
      "co.in", "firm.in", "net.in", "org.in",
      "co.nz", "com.br", "com.cn",
      "co.jp", "co.kr", "com.sg",
    ]);

    const suffix = labels.slice(-2).join(".");
    const suffixLength = twoLabelSuffixes.has(suffix) ? 2 : 1;
    const isApex = labels.length === suffixLength + 1;

    const ipv4 = (config.recommendedIPv4 || []).find(
      (record) => Number(record.rank) === 1
    )?.value;

    const cname = (config.recommendedCNAME || []).find(
      (record) => Number(record.rank) === 1
    )?.value;

    const records = [];

    if (isApex && ipv4) {
      for (const value of Array.isArray(ipv4) ? ipv4 : [ipv4]) {
        records.push({ type: "A", name: "@", value });
      }
    } else if (!isApex && cname) {
      records.push({
        type: "CNAME",
        name: labels.slice(0, -(suffixLength + 1)).join("."),
        value: cname,
      });
    }

    res.json({
      verified: Boolean(verification.verified),
      misconfigured: Boolean(config.misconfigured),
      records,
      verification: verification.verification || [],
    });
  } catch (e) {
    fail(res, e);
  }
});

module.exports = router;